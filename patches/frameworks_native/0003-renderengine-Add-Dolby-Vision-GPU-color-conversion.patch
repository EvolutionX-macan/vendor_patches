index 0000000000000000000000000000000000000000..16839179e76986b20741c18d8f59dccc902d9e21
--- /dev/null
+++ b/libs/renderengine/skia/filters/DolbyShader.cpp
@@ -0,0 +1,289 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#include "DolbyShader.h"
+
+#include <android-base/properties.h>
+#include <android/binder_manager.h>
+#include <android/hardware/graphics/mapper/IMapper.h>
+#include <dlfcn.h>
+#include <include/core/SkBitmap.h>
+#include <include/core/SkTileMode.h>
+#include <include/effects/SkRuntimeEffect.h>
+#include <log/log.h>
+#include <vndk/hardware_buffer.h>
+
+#include <cstring>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include <renderengine/ColorSpaces.h>
+
+namespace android::renderengine::skia {
+namespace {
+
+// DolbyEffect 4.1 uses CICP primary/transfer identifiers and a separate range
+// enumeration (limited=0, full=1). This adapter is deliberately version-specific.
+struct DolbyColor {
+    int32_t primaries;
+    int32_t range;
+    int32_t transfer;
+};
+struct DolbyUniform {
+    std::string name;
+    std::vector<uint8_t> value;
+};
+static_assert(sizeof(DolbyColor) == 12);
+
+std::optional<DolbyColor> toDolbyColor(ui::Dataspace dataspace) {
+    DolbyColor color{};
+    switch (static_cast<ui::Dataspace>(dataspace & ui::Dataspace::STANDARD_MASK)) {
+        case ui::Dataspace::STANDARD_BT709:
+            color.primaries = 1;
+            break;
+        case ui::Dataspace::STANDARD_BT2020:
+            color.primaries = 9;
+            break;
+        case ui::Dataspace::STANDARD_DCI_P3:
+            color.primaries = 12;
+            break;
+        default:
+            return std::nullopt;
+    }
+    switch (static_cast<ui::Dataspace>(dataspace & ui::Dataspace::TRANSFER_MASK)) {
+        case ui::Dataspace::TRANSFER_LINEAR:
+            color.transfer = 8;
+            break;
+        // Match the stock integration's sRGB/BT.709 target selection.
+        case ui::Dataspace::TRANSFER_SRGB:
+            color.transfer = 1;
+            break;
+        case ui::Dataspace::TRANSFER_SMPTE_170M:
+            color.transfer = 6;
+            break;
+        case ui::Dataspace::TRANSFER_GAMMA2_2:
+            color.transfer = 4;
+            break;
+        case ui::Dataspace::TRANSFER_GAMMA2_6:
+            color.transfer = 5;
+            break;
+        case ui::Dataspace::TRANSFER_GAMMA2_8:
+            color.transfer = 3;
+            break;
+        case ui::Dataspace::TRANSFER_ST2084:
+            color.transfer = 16;
+            break;
+        case ui::Dataspace::TRANSFER_HLG:
+            color.transfer = 18;
+            break;
+        default:
+            return std::nullopt;
+    }
+    switch (static_cast<ui::Dataspace>(dataspace & ui::Dataspace::RANGE_MASK)) {
+        case ui::Dataspace::RANGE_FULL:
+            color.range = 1;
+            break;
+        case ui::Dataspace::RANGE_LIMITED:
+            color.range = 0;
+            break;
+        default:
+            return std::nullopt;
+    }
+    return color;
+}
+
+}  // namespace
+
+struct DolbyShader::State {
+    void* library = nullptr;
+    void* mapperLibrary = nullptr;
+    AIMapper* mapper = nullptr;
+    void* effect = nullptr;
+    sk_sp<SkRuntimeEffect> runtimeEffect;
+    // Last QTI CUSTOM_CONTENT_METADATA size; the QTI mapper warns on size probes.
+    int32_t metadataSize = 0;
+
+    void* (*create)() = nullptr;
+    void (*destroy)(void*) = nullptr;
+    void (*setMetadata)(void*, unsigned char*, unsigned int) = nullptr;
+    void (*setSource)(void*, DolbyColor*) = nullptr;
+    void (*setTarget)(void*, DolbyColor*) = nullptr;
+    void (*enableInverseMatrix)(void*) = nullptr;
+    void* (*generateLut)(void*, int*) = nullptr;
+    const char* (*getShader)(void*) = nullptr;
+    std::vector<DolbyUniform> (*getUniforms)(void*) = nullptr;
+    bool (*needsEffect)(void*) = nullptr;
+
+    template <typename T>
+    bool symbol(T& target, const char* name) {
+        target = reinterpret_cast<T>(dlsym(library, name));
+        return target != nullptr;
+    }
+
+    // The vendor library is a non-CFI DSO. Keep its ABI calls in this adapter.
+    __attribute__((no_sanitize("cfi"))) bool init() {
+        mapperLibrary =
+                AServiceManager_openDeclaredPassthroughHal("mapper", "qti", RTLD_NOW | RTLD_LOCAL);
+        if (!mapperLibrary) return false;
+        auto loadMapper = reinterpret_cast<AIMapper_Error (*)(AIMapper**)>(
+                dlsym(mapperLibrary, "AIMapper_loadIMapper"));
+        if (!loadMapper || loadMapper(&mapper) != AIMAPPER_ERROR_NONE || !mapper ||
+            mapper->version < AIMAPPER_VERSION_5) {
+            return false;
+        }
+        library = dlopen("/system_ext/lib64/libdolbyeffect_4.1.so", RTLD_NOW | RTLD_LOCAL);
+        if (!library) return false;
+        if (!symbol(create, "_ZN11dolbyVision11DolbyEffect11instantiateEv") ||
+            !symbol(destroy, "_ZN11dolbyVision15DolbyEffectImplD0Ev") ||
+            !symbol(setMetadata, "_ZN11dolbyVision15DolbyEffectImpl13setDvMetadataEPhj") ||
+            !symbol(setSource,
+                    "_ZN11dolbyVision15DolbyEffectImpl22setSourceColorMetadataEPNS_"
+                    "15DVColorMetaDataE") ||
+            !symbol(setTarget,
+                    "_ZN11dolbyVision15DolbyEffectImpl22setTargetColorMetadataEPNS_"
+                    "15DVColorMetaDataE") ||
+            !symbol(enableInverseMatrix,
+                    "_ZN11dolbyVision15DolbyEffectImpl30enableInverseMatrixNoDVSKPatchEv") ||
+            !symbol(generateLut, "_ZN11dolbyVision15DolbyEffectImpl11generateLutEPi") ||
+            !symbol(getShader, "_ZN11dolbyVision15DolbyEffectImpl15getShaderStringEv") ||
+            !symbol(getUniforms, "_ZN11dolbyVision15DolbyEffectImpl11getUniformsEv") ||
+            !symbol(needsEffect, "_ZN11dolbyVision15DolbyEffectImpl16needsDolbyEffectEv")) {
+            return false;
+        }
+        effect = create();
+        if (!effect) return false;
+        // Upstream Skia performs the OES YUV->RGB conversion. The vendor shader
+        // must undo that conversion to recover IPT before applying the Dolby LUT.
+        enableInverseMatrix(effect);
+        const char* shader = getShader(effect);
+        if (!shader) return false;
+        auto result = SkRuntimeEffect::MakeForShader(SkString(shader));
+        runtimeEffect = std::move(result.effect);
+        if (!runtimeEffect) {
+            ALOGW("DolbyShader: shader compilation failed: %s", result.errorText.c_str());
+        }
+        return runtimeEffect != nullptr;
+    }
+
+    __attribute__((no_sanitize("cfi"))) ~State() {
+        if (effect && destroy) destroy(effect);
+        if (library) dlclose(library);
+        if (mapperLibrary) dlclose(mapperLibrary);
+    }
+
+    __attribute__((no_sanitize("cfi"))) std::vector<uint8_t> metadata(
+            const sp<GraphicBuffer>& buffer) {
+        const auto* handle = AHardwareBuffer_getNativeHandle(buffer->toAHardwareBuffer());
+        constexpr AIMapper_MetadataType type = {"QTI", 10029};
+        std::vector<uint8_t> data;
+        int32_t size = -1;
+        if (metadataSize > 0) {
+            data.resize(metadataSize);
+            size = mapper->v5.getMetadata(handle, type, data.data(), data.size());
+        }
+        if (metadataSize <= 0 || size != metadataSize) {
+            size = mapper->v5.getMetadata(handle, type, nullptr, 0);
+            if (size < 15 || size > 65536) return {};
+            data.resize(size);
+            if (mapper->v5.getMetadata(handle, type, data.data(), data.size()) != size) return {};
+            metadataSize = size;
+        }
+        // QTI CUSTOM_CONTENT_METADATA: uint64_t length followed by the RPU.
+        uint64_t length;
+        std::memcpy(&length, data.data(), sizeof(length));
+        constexpr uint8_t rpuStart[] = {0, 0, 0, 1, 0x7c, 1, 0x19};
+        if (length < sizeof(rpuStart) || length > data.size() - sizeof(length) ||
+            std::memcmp(data.data() + sizeof(length), rpuStart, sizeof(rpuStart)) != 0) {
+            return {};
+        }
+        data.erase(data.begin(), data.begin() + sizeof(length));
+        data.resize(length);
+        return data;
+    }
+
+    __attribute__((no_sanitize("cfi"))) sk_sp<SkShader> build(const sk_sp<SkImage>& image,
+                                                              const SkMatrix& matrix,
+                                                              const SkSamplingOptions& sampling,
+                                                              std::vector<uint8_t>& metadata,
+                                                              DolbyColor source, DolbyColor target,
+                                                              ui::Dataspace output) {
+        setSource(effect, &source);
+        setMetadata(effect, metadata.data(), metadata.size());
+        setTarget(effect, &target);
+        if (!needsEffect(effect)) return nullptr;
+        int size = 0;
+        const void* pixels = generateLut(effect, &size);
+        if (!pixels || size < 2 || size > 65) return nullptr;
+        auto colorSpace = toSkColorSpace(output);
+        SkBitmap bitmap;
+        // The 4.1 SDK returns a flattened, opaque RGB101010 LUT, not float pixels.
+        if (!bitmap.tryAllocPixels(SkImageInfo::Make(size * size, size, kRGB_101010x_SkColorType,
+                                                     kOpaque_SkAlphaType, colorSpace))) {
+            return nullptr;
+        }
+        std::memcpy(bitmap.getPixels(), pixels, static_cast<size_t>(size) * size * size * 4);
+        auto lutImage = SkImages::RasterFromBitmap(bitmap);
+        if (!lutImage) return nullptr;
+        SkRuntimeShaderBuilder builder(runtimeEffect);
+        for (const auto& uniform : getUniforms(effect)) {
+            const auto* definition = runtimeEffect->findUniform(uniform.name.c_str());
+            if (!definition || definition->sizeInBytes() != uniform.value.size()) return nullptr;
+            builder.uniform(uniform.name.c_str()).set(uniform.value.data(), uniform.value.size());
+        }
+        SkMatrix lutMatrix = SkMatrix::Scale(1.f / (size * size), 1.f / size);
+        builder.child("lut_cube") =
+                lutImage->makeShader(SkSamplingOptions(SkFilterMode::kLinear), lutMatrix);
+        // The LUT consumes the raw GPU sample and emits pixels in the target
+        // encoding. Retagging avoids treating native Dolby IPT as ordinary PQ.
+        auto rawImage = image->reinterpretColorSpace(colorSpace);
+        if (!rawImage) return nullptr;
+        builder.child("child") =
+                rawImage->makeShader(SkTileMode::kClamp, SkTileMode::kClamp, sampling, &matrix);
+        auto shader = builder.makeShader();
+        // Preserve nonlinear samples inside this effect, including when the
+        // outer dimming/color-transform effect uses a linear working space.
+        return shader ? shader->makeWithWorkingColorSpace(colorSpace) : nullptr;
+    }
+};
+
+DolbyShader::DolbyShader()
+    : mEnabled(base::GetBoolProperty("ro.surface_flinger.supports_dolby_vision", false)) {}
+DolbyShader::~DolbyShader() = default;
+
+sk_sp<SkShader> DolbyShader::makeShader(const sk_sp<SkImage>& image, const SkMatrix& matrix,
+                                        const SkSamplingOptions& sampling,
+                                        const sp<GraphicBuffer>& buffer, ui::Dataspace source,
+                                        ui::Dataspace output) {
+    if (!mEnabled || !image || !buffer ||
+        (source & ui::Dataspace::STANDARD_MASK) !=
+                static_cast<int32_t>(ui::Dataspace::STANDARD_BT2020) ||
+        (source & ui::Dataspace::TRANSFER_MASK) !=
+                static_cast<int32_t>(ui::Dataspace::TRANSFER_ST2084)) {
+        return nullptr;
+    }
+    auto sourceColor = toDolbyColor(source);
+    auto targetColor = toDolbyColor(output);
+    if (!sourceColor || !targetColor) return nullptr;
+    if (!mInitialized) {
+        mInitialized = true;
+        auto state = std::make_unique<State>();
+        if (state->init())
+            mState = std::move(state);
+        else
+            ALOGW("DolbyShader: optional DolbyEffect 4.1 adapter unavailable");
+    }
+    if (!mState) return nullptr;
+    auto metadata = mState->metadata(buffer);
+    if (metadata.empty()) return nullptr;
+    auto shader =
+            mState->build(image, matrix, sampling, metadata, *sourceColor, *targetColor, output);
+    if (shader && !mLoggedSuccess) {
+        ALOGI("DolbyShader: enabled DolbyEffect 4.1 GPU color conversion");
+        mLoggedSuccess = true;
+    }
+    return shader;
+}
+
+}  // namespace android::renderengine::skia
